{
  "name": "fintran-tiger-platform",
  "version": "3.0.0",
  "description": "FinTran × Tiger — Finance AI Platform (Vision → Command Center → CloseIQ)",
  "private": true,
  "scripts": {
    "build":   "python3 scripts/build_platform.py",
    "build:closeiq": "python3 scripts/build.py",
    "serve":   "python3 -m http.server 3000 --directory public",
    "dev":     "python3 scripts/build_platform.py && python3 -m http.server 3000 --directory public",
    "docker":  "docker compose -f deploy/docker-compose.yml up --build -d",
    "docker:stop": "docker compose -f deploy/docker-compose.yml down"
  },
  "engines": { "python": ">=3.9" },
  "keywords": ["finance", "ai", "agents", "tiger-analytics", "fintran", "close"],
  "author": "Tiger Analytics",
  "license": "UNLICENSED"
}
